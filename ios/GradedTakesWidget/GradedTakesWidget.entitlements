<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget runs as a separate process; this is the only way it can
	     read the JSON the app writes after each refresh. Must match
	     GradedTakes.entitlements exactly. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.gradedtakes.app</string>
	</array>
</dict>
</plist>
